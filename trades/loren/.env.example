# Telegram (Get API_ID and API_HASH from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_NAME=loren_session
TELEGRAM_CHANNEL_ID=your_channel_id_here

# Pocket Option Credentials
POCKET_OPTION_EMAIL=your_email@example.com
POCKET_OPTION_PASSWORD=your_password

# Trading Settings
DEFAULT_AMOUNT=10.0
CURRENCY=USD
MAX_MARTINGALE_LEVELS=3
MARTINGALE_MULTIPLIER=2.5

# Timezone for signal times (important for correct trade scheduling)
# BlackStar/Lorenzo signals use West Africa time (UTC+1), so set: TIMEZONE=UTC+1
# Signals from other regions: set to their timezone offset
# Format: UTC+X or UTC-X (e.g., UTC+1, UTC-5). Default is UTC.
TIMEZONE=UTC+1

# Web UI Authentication (change these in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SECRET_KEY=change-this-to-a-random-secret-key-for-production

# Pocket Option SSID (get from browser DevTools after login)
# POCKET_OPTION_SSID=your_session_token_here

# Telegram Notifications (optional - for signal/trade alerts)
# Set to your Telegram user ID or channel to receive notifications
# Get your user ID from @userinfobot on Telegram
NOTIFICATION_USER_ID=your_telegram_user_id_here
# OR use a channel: NOTIFICATION_CHANNEL_ID=@your_channel_username

# Email reports (daily / weekly / monthly)
REPORT_EMAIL_ENABLED=true
REPORT_EMAIL_TO=ayomikunariyo@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=TelVictory <your_sender@gmail.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
REPORT_DAILY_HOUR=8
REPORT_DAILY_MINUTE=0
REPORT_WEEKLY_DAY=mon
REPORT_MONTHLY_DAY=1

# Bot Behavior
# Set to 'true' to monitor ALL joined channels for signals (recommended for multi-channel use)
# Set to 'false' to only monitor TELEGRAM_CHANNEL_ID
MONITOR_ALL_CHANNELS=true
